# Copy to .env and fill in. .env is gitignored — never commit secrets.

# Backend: sim | pidog | picrawler (Mac default: SoftPicrawler via config; omit or set picrawler)
# SHIKIGAMI_BACKEND=picrawler

# LLM — any OpenAI-compatible endpoint. Default: Requesty router (provider-prefixed model names).
# Local alternative: Ollama on jesktop -> LLM_BASE_URL=http://jesktop:11434/v1, no key needed.
LLM_BASE_URL=https://router.requesty.ai/v1
LLM_MODEL=openai/gpt-4o-mini
SHIKIGAMI_API_KEY=

# STT — OpenAI-compatible /audio/transcriptions
# Local (jesktop): run `make setup-whisper` there, then:
STT_BASE_URL=http://jesktop:8000/v1
STT_MODEL=Systran/faster-whisper-medium
STT_API_KEY=not-needed
# Cloud (Requesty voxtral):
# STT_BASE_URL=https://router.requesty.ai/v1
# STT_MODEL=mistral/voxtral-mini-latest
# STT_API_KEY=


# TTS — provider: openai | piper (local binary) | piper-http (remote Piper server) | none
# With openai, TTS_BASE_URL/TTS_MODEL/TTS_VOICE/TTS_API_KEY are used.
# With piper-http only TTS_BASE_URL matters (no key): run `make setup-piper` on jesktop or the Mac,
# German voice de_DE-thorsten-medium by default
# (voices: https://huggingface.co/rhasspy/piper-voices/tree/main/de/de_DE).
TTS_PROVIDER=openai
TTS_BASE_URL=https://router.requesty.ai/v1
TTS_MODEL=openai/tts-1
TTS_VOICE=alloy
TTS_API_KEY=
# TTS_PROVIDER=piper-http
# TTS_BASE_URL=http://jesktop:5000        # or http://localhost:5000 when running locally
# piper local binary: TTS_PIPER_VOICE=/path/to/de_DE-thorsten-medium.onnx

# Deploy script target
DEPLOY_HOST=pi@raspberrypi.local
