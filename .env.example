# Copy to .env and fill in. .env is gitignored — never commit secrets.

# Backend: sim | pidog | picrawler (Mac default: SoftPicrawler via config; omit or set picrawler)
# SHIKIGAMI_BACKEND=picrawler

# LLM — Requesty EU router (same stack as ket-chat voice).
# Local alternative: Ollama on jesktop -> LLM_BASE_URL=http://jesktop:11434/v1, no key needed.
LLM_BASE_URL=https://router.eu.requesty.ai/v1
LLM_MODEL=vertex/claude-haiku-5-5@eu
SHIKIGAMI_API_KEY=

# STT — OpenAI-compatible /audio/transcriptions
# Local (jesktop): run `make setup-whisper` there, then:
STT_BASE_URL=http://jesktop:8000/v1
STT_MODEL=Systran/faster-whisper-medium
STT_API_KEY=not-needed
# Cloud (Requesty voxtral):
# STT_BASE_URL=https://router.requesty.ai/v1
# STT_MODEL=mistral/voxtral-mini-latest
# STT_API_KEY=


# TTS — piper-http (default) talks to the server from `make setup-piper`.
# The app does not import piper-tts (GPL-3.0); that package stays in the server venv.
# On macOS, port 5000 is AirPlay Receiver — use another port if you run Piper locally.
TTS_PROVIDER=piper-http
TTS_BASE_URL=http://jesktop:5000
# TTS_BASE_URL=http://127.0.0.1:5000
# Optional OpenAI-compatible TTS (Pipecat requests PCM at 24 kHz; some routers only serve WAV):
# TTS_PROVIDER=openai
# TTS_BASE_URL=https://router.requesty.ai/v1
# TTS_MODEL=openai/tts-1
# TTS_VOICE=alloy
# TTS_API_KEY=

# Voice pipeline. Unset values keep config/default.yaml.
# VOICE_BARGE_IN=true
# VOICE_INTERRUPT_WHILE_MOVING=false
# VOICE_SMART_TURN=true
# VOICE_ECHO_GUARD=true        # mic closed while the speaker is audible; false only with headphones
# VOICE_ECHO_TAIL_SECS=0.3
# SHIKIGAMI_VOICE_TRANSPORT=sounddevice

# Deploy script target
DEPLOY_HOST=pi@raspberrypi.local
