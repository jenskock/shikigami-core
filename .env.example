# Copy to .env and fill in. .env is gitignored — never commit secrets.

# Backend: sim | pidog | picrawler  (also settable via SHIKIGAMI_BACKEND)
SHIKIGAMI_BACKEND=sim

# LLM — any OpenAI-compatible endpoint.
# Default cloud: Requesty router (provider-prefixed model names, e.g. openai/gpt-4o-mini).
# Local: Ollama on "jesktop" → LLM_BASE_URL=http://jesktop:11434/v1 (no key needed).
LLM_BASE_URL=https://router.requesty.ai/v1
LLM_MODEL=openai/gpt-4o-mini
SHIKIGAMI_API_KEY=
# Ollama needs no key; the client falls back to a dummy key automatically.

# STT — OpenAI-compatible /audio/transcriptions (Requesty voxtral, or a Whisper server on jesktop)
STT_BASE_URL=https://router.requesty.ai/v1
STT_MODEL=mistral/voxtral-mini-latest
STT_API_KEY=

# TTS — provider: openai (OpenAI-compatible /audio/speech) | piper (local binary)
#          | piper-http (remote Piper HTTP server, fastest — no cloud round-trip) | none
TTS_PROVIDER=openai
TTS_BASE_URL=https://router.requesty.ai/v1
TTS_MODEL=openai/tts-1
TTS_VOICE=alloy
TTS_API_KEY=
# piper-http on jesktop with a GERMAN voice (model is chosen server-side).
#   Easiest: run `make setup-piper` on jesktop (venv + piper-tts[http] + voice download + server).
#   Or manually: python3 -m piper.http_server --model de_DE-thorsten-medium.onnx --port 5000
#   TTS_PROVIDER=piper-http, TTS_BASE_URL=http://jesktop:5000
#   (works locally on the Mac too: TTS_BASE_URL=http://localhost:5000)
#   voices: https://huggingface.co/rhasspy/piper-voices/tree/main/de/de_DE
#   client auto-detects the endpoint (/api/tts on piper 1.3.x, /synthesize on >= 1.8)
# piper local binary: TTS_PROVIDER=piper + path to a German .onnx voice model
# TTS_PIPER_VOICE=/path/to/de_DE-thorsten-medium.onnx

# Deploy script target
DEPLOY_HOST=pi@raspberrypi.local
